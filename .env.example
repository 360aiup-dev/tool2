# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_2: 第二個 Google 帳號的 Gemini API Key (支援 GitHub Actions Secrets: GEMINI_API_KEY_2)
# 系統已啟動「雙金鑰負載平衡 (Round-Robin)」與「自動容錯 (Failover)」：
# 1. 正常時：每筆請求輪流分配至 Key 1 與 Key 2，請求額度直接翻倍 (各承擔 50%)。
# 2. 配額耗盡時 (429)：自動切換至另一個 Key，並搭配 5 級階梯式模型降級保障服務不中斷。
GEMINI_API_KEY_2=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

